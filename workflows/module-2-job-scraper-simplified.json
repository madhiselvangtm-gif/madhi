{
  "name": "Module 2 - Job Scraper (Simplified RSS)",
  "nodes": [
    {
      "parameters": {},
      "id": "start-module-2",
      "name": "Start from Module 1",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [240, 400],
      "notes": "📥 INPUT FROM MODULE 1\n\nReceives:\n- runId\n- timestamp\n- date\n\nThis connects from Module 1's output in the master workflow."
    },
    {
      "parameters": {
        "url": "https://www.linkedin.com/jobs/search/?keywords=Sales%20Development%20Representative&location=India&f_WT=2/feed",
        "options": {}
      },
      "id": "scrape-linkedin-rss",
      "name": "Scrape LinkedIn Jobs (RSS)",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [460, 300],
      "notes": "🔗 LINKEDIN RSS SCRAPER\n\n⚠️ SETUP REQUIRED:\n1. Go to: https://www.linkedin.com/jobs/\n2. Search: 'Sales Development Representative India'\n3. Apply filters (Remote, Mid-Level, etc.)\n4. Copy the URL from address bar\n5. Add '/feed' to the end\n6. Paste here as Feed URL\n\nExample:\nhttps://www.linkedin.com/jobs/search/?keywords=SDR&location=India/feed\n\nf_WT=2 means Remote jobs only"
    },
    {
      "parameters": {
        "url": "https://www.indeed.co.in/rss?q=BDR&l=Bangalore&fromage=7",
        "options": {}
      },
      "id": "scrape-indeed-rss",
      "name": "Scrape Indeed Jobs (RSS)",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [460, 500],
      "notes": "🔗 INDEED RSS SCRAPER\n\n⚠️ SETUP REQUIRED:\n1. Go to: https://www.indeed.co.in/\n2. Search: 'BDR Bangalore'\n3. Copy the URL\n4. Change '/jobs?' to '/rss?'\n5. Add '&fromage=7' for last 7 days only\n6. Paste here as Feed URL\n\nExample:\nhttps://www.indeed.co.in/rss?q=SDR&l=Bangalore&fromage=7"
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "options": {}
      },
      "id": "merge-job-sources",
      "name": "Merge All Job Sources",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [680, 400],
      "notes": "🔀 MERGE NODE\n\nCombines jobs from LinkedIn + Indeed into one stream.\n\nNothing to configure."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "add-platform",
              "name": "sourcePlatform",
              "value": "={{ $node[\"Scrape LinkedIn Jobs (RSS)\"].json ? 'LinkedIn' : 'Indeed' }}",
              "type": "string"
            },
            {
              "id": "add-runid",
              "name": "runId",
              "value": "={{ $('Start from Module 1').first().json.runId }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "add-metadata",
      "name": "Add Metadata",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [900, 400],
      "notes": "📝 ADD METADATA\n\nAdds tracking info to each job:\n- sourcePlatform (LinkedIn or Indeed)\n- runId (from Module 1)\n\nThis helps with deduplication later."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "output-runid",
              "name": "runId",
              "value": "={{ $('Start from Module 1').first().json.runId }}",
              "type": "string"
            },
            {
              "id": "output-count",
              "name": "jobsScraped",
              "value": "={{ $items().length }}",
              "type": "number"
            },
            {
              "id": "output-status",
              "name": "status",
              "value": "Scraped",
              "type": "string"
            }
          ]
        }
      },
      "id": "output-to-module-3",
      "name": "Output to Module 3",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [1120, 400],
      "notes": "🚀 OUTPUT TO MODULE 3\n\nPrepares data for Filter & Dedupe module:\n- runId\n- jobsScraped count\n- status\n\nThis connects to Module 3's input."
    }
  ],
